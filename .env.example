# This is a settings reference, not runnable configuration.
# For a new local install: python3 scripts/bootstrap_env.py
# See SECURITY_BOOTSTRAP.md for initial administrator setup and upgrades.
DATABASE_URL=sqlite:///./raven.db

# Required independent private random secrets, at least 32 characters each.
# Generate through the bootstrap helper or a secret manager; never reuse examples.
JWT_SECRET_KEY=
FLOCK_INTERNAL_TOKEN=
# Optional: only seeds a new enrollment record. 32..72 UTF-8 bytes.
# Existing records are NOT rotated or re-enabled by changing this value.
FLOCK_ENROLLMENT_TOKEN=

# Optional empty-DB bootstrap alternative to the interactive init-admin command.
# Supply both only through a private secret manager. Remove after initialization.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FRONTEND_ORIGIN=http://localhost:3000
DEBUG=false
EMBEDDED_MONITORING=false
MONITOR_POLL_SECONDS=5
RUNNER_POLL_SECONDS=5
# Required only for SSH execution. Administrator-provisioned absolute path.
# See SSH_HOST_VERIFICATION.md; absence never opts into insecure host acceptance.
SSH_KNOWN_HOSTS_PATH=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
